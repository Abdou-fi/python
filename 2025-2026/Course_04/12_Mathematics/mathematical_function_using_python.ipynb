      "text/latex": [
       "$\\displaystyle solve(a, b, c) = \\frac{- b + \\sqrt{- 4 a c + b^{2}}}{2 a}$"
      ],
      "text/plain": [
       "Eq(solve(a, b, c), (-b + sqrt(-4*a*c + b**2))/(2*a))"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import sympy as sp \n",
    "from IPython.display import display \n",
    "a, b, c = sp.symbols('a b c')\n",
    "expr = (-b + sp.sqrt(b**2 - 4*a*c)) / (2*a)\n",
    "\n",
    "display(sp.Eq(sp.Symbol(\"solve(a, b, c)\"), expr))"
   ]
  }
